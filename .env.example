# Environment variables required for the brownfield-to-intent pipeline.
# Copy this file to .env and fill in values before running Approach B
# (single-agent LLM baseline) or any LLM-dependent pipeline path.
#
# .env is git-ignored. Never commit a file with real credentials.

# OpenAI API key (required for Approach B and the LLM fallback path in Approach C)
OPENAI_API_KEY=

# Exact OpenAI model snapshot to use for reproducibility.
# Do NOT use the bare alias "gpt-4" — it resolves to a moving target.
OPENAI_MODEL=gpt-4-0125-preview

# Optional: LLM sampling temperature (default 0.1 if unset)
# LLM_TEMPERATURE=0.1
